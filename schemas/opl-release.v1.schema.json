{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onepersonlab.ai/schemas/opl-release.v1.schema.json",
  "title": "OPL Release Configuration (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject_id", "kind", "repository", "schedule", "lanes"],
  "properties": {
    "schema_version": { "const": "opl.release.v1" },
    "subject_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "kind": { "enum": ["product", "package"] },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "schedule": { "enum": ["daily_patch", "owner_schedule", "manual"] },
    "trigger": { "enum": ["tag", "owner_schedule", "manual"] },
    "tag_prefix": { "type": "string", "pattern": "^[A-Za-z0-9._-]*$" },
    "tag_suffix": { "type": "string", "pattern": "^[A-Za-z0-9._-]*$" },
    "delivery_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "version_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["json", "toml_project", "python_version", "plist_bundle", "xml_project"] },
          "field": { "type": "string", "minLength": 1 }
        }
      }
    },
    "source_check_workflows": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.ya?ml$" },
      "uniqueItems": true
    },
    "prepare": {
      "type": "array",
      "items": { "type": "array", "minItems": 1, "items": { "type": "string" } }
    },
    "verify": {
      "type": "array",
      "items": { "type": "array", "minItems": 1, "items": { "type": "string" } }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lane", "workflow"],
        "properties": {
          "lane": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "workflow": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.ya?ml$" },
          "primary": { "type": "boolean" },
          "event": { "type": "string" },
          "match": { "enum": ["tag", "title", "latest"] },
          "title_pattern": { "type": "string" },
          "title_from_tag": { "type": "string" },
          "receipt_required": { "type": "boolean" },
          "qualification_required": { "type": "boolean" },
          "recheck_after_success": { "type": "boolean" },
          "daily_dispatch": {
            "type": "object",
            "additionalProperties": false,
            "required": ["enabled", "control_run_id_input"],
            "properties": {
              "enabled": { "const": true },
              "ref": { "type": "string", "minLength": 1 },
              "control_run_id_input": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "inputs": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              }
            }
          },
          "channel": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["oci", "github_release", "github_prerelease", "sparkle_appcast"] },
              "registry": { "type": "string" },
              "repository": { "type": "string" },
              "tag": { "type": "string" },
              "tag_pattern": { "type": "string" },
              "asset": { "type": "string" },
              "asset_pattern": { "type": "string" },
              "release_tag": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
