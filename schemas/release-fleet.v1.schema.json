{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onepersonlab.ai/schemas/release-fleet.v1.schema.json",
  "title": "OPL Release Fleet Inventory (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner", "products"],
  "properties": {
    "schema_version": { "const": "opl.release-fleet.v1" },
    "owner": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
    "catalog_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "index_path", "oci_registry", "oci_namespace"],
      "properties": {
        "repository": { "type": "string" },
        "ref": { "type": "string" },
        "index_path": { "type": "string" },
        "oci_registry": { "type": "string" },
        "oci_namespace": { "type": "string" }
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject_id", "repository"],
        "properties": {
          "subject_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
          "observe_only": { "type": "boolean" },
          "enable_owner_dispatch": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
